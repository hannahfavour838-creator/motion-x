# ─────────────────────────────────────────────────────────────────────────────
# MOTION X — environment variables
# Copy to .env.local for development. Placeholder values only — never commit
# real credentials. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemaps, auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required for accounts, listings, enquiries, admin) ────────────
# Without these the site runs in preview mode with demonstration inventory only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Used ONLY by the exchange-rate cron job and scripts/grant-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Show demonstration inventory? Defaults to true without Supabase, false is
# recommended in production (demo rows are only present if you ran seed.sql).
NEXT_PUBLIC_SHOW_DEMO_INVENTORY=false

# ── Exchange rates (optional) ───────────────────────────────────────────────
# "open-er-api" (ExchangeRate-API open access, includes AED) or "frankfurter"
# (ECB reference rates). Leave empty to show original prices only.
EXCHANGE_RATES_PROVIDER=
# Display currencies offered for estimated conversions
NEXT_PUBLIC_DISPLAY_CURRENCIES=USD,EUR,GBP,AED
# Protects /api/cron/exchange-rates (Vercel Cron sends it automatically)
CRON_SECRET=generate-a-long-random-string

# ── Analytics (optional, cookieless) ────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── Misc (optional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
# Salt for hashing IP addresses in rate limiting
RATE_LIMIT_SALT=generate-a-random-string
# Social links appear in the footer only when set
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
